[Icon Theme]
Name=Mocha-Icons
Comment=Adwaita's symbolic icons (they match GNOME Shell's weight) over Colloid Orange Catppuccin's app and folder icons
Inherits=Colloid-Orange-Catppuccin-Dark,Adwaita,hicolor
Directories=symbolic/actions,symbolic/apps,symbolic/categories,symbolic/devices,symbolic/emblems,symbolic/emotes,symbolic/mimetypes,symbolic/places,symbolic/status,symbolic/legacy,symbolic/ui

[symbolic/actions]
Context=Actions
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/apps]
Context=Applications
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/categories]
Context=Categories
Size=16
MinSize=8
MaxSize=512
Type=Scalable

